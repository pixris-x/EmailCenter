{
  "name": "email-center",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev:backend": "pnpm --dir backend dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "start:backend": "pnpm --dir backend start",
    "build:frontend": "pnpm --dir frontend build",
    "db:migrate": "pnpm --dir backend db:migrate",
    "worker:email": "pnpm --dir backend worker:email",
    "redis:ping": "pnpm --dir backend redis:ping",
    "queue:test": "pnpm --dir backend queue:test",
    "admin:hash": "pnpm --dir backend admin:hash",
    "admin:create": "pnpm --dir backend admin:create",
    "logs:purge": "pnpm --dir backend logs:purge",
    "lint": "pnpm --dir backend lint && pnpm --dir frontend lint",
    "test:backend": "pnpm --dir backend test",
    "test:e2e": "node scripts/e2e/e2e.cjs",
    "verify": "pnpm lint && pnpm test:backend && pnpm build:frontend"
  },
  "devDependencies": {
    "eslint": "^10.9.1"
  }
}
