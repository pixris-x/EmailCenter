# App
APP_NAME=Email Center
APP_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
APP_WEB_URL=http://localhost:5173
APP_JWT_SECRET=
APP_JWT_EXPIRES_IN=12h
APP_ENCRYPTION_KEY=
APP_ATTACHMENT_DIR=./storage/attachments

# Login protection (admin console)
# 同一邮箱 15 分钟内失败超过 APP_LOGIN_MAX_FAILURES 次，锁定 APP_LOGIN_LOCK_MINUTES 分钟
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_LOCK_MINUTES=30
# 同一 IP 每分钟登录尝试超过该值将返回 429
APP_LOGIN_IP_MAX_PER_MINUTE=10

# Database
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_SCHEMA=public

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Resend SMTP
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
RESEND_SMTP_PASS=

# Mail defaults
MAIL_DEFAULT_FROM_NAME=Pixris
MAIL_DEFAULT_FROM_EMAIL=noreply@email.pixris.online
MAIL_ATTACHMENT_MAX_MB=10
MAIL_ALLOWED_ATTACHMENT_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.zip
MAIL_ALLOWED_ATTACHMENT_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,application/zip,application/x-zip-compressed

# Queue
QUEUE_EMAIL_NAME=email-send
QUEUE_EMAIL_CONCURRENCY=1
QUEUE_EMAIL_MAX_RETRIES=3

# Internal API
INTERNAL_API_RATE_LIMIT_PER_MINUTE=30

# Log retention (days) for `pnpm logs:purge`; run daily via cron / 宝塔计划任务
LOG_RETENTION_DAYS=180

# Resend 回执 webhook（批次 2）：在 Resend dashboard / API 创建 webhook，
# 事件 endpoint 指向 https://email.pixris.online/api/webhooks/resend，
# 事件选择 email.bounced / email.complained / email.delivered / email.opened / email.clicked。
# Resend 使用 Svix 标准签名（svix-id / svix-timestamp / svix-signature）。
# ⚠️ 模板文件：此处务必留空。真实密钥只填到服务器 .env（已被 .gitignore 忽略），不要提交。
RESEND_WEBHOOK_SECRET=
# 签名时间戳容差（秒），默认 300
RESEND_WEBHOOK_TOLERANCE_SECONDS=300

# 退信/失败告警接收邮箱
MAIL_ALERT_TO=sunshineforluck@163.com

# Bootstrap admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Frontend
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
VITE_API_ENABLE_LOG=false
VITE_API_RETRY_COUNT=1
VITE_API_RETRY_DELAY_MS=400

